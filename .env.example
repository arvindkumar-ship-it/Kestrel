# Copy to .env and fill in real values. Never commit the real .env file.

# --- Runtime ---
APP_ENV=local                    # local | test | staging | production
DEBUG=true

# --- Response engine safety switches ---
# In production: ALLOW_DRY_RUN_RESPONSES must be false (explicit response mode required)
# and AUTONOMOUS_ACTIONS_ENABLED is a separate, explicit opt-in.
ALLOW_DRY_RUN_RESPONSES=true
AUTONOMOUS_ACTIONS_ENABLED=false

# --- URLs ---
API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000   # must be https:// in production

# --- Datastores (docker-compose defaults below; override for staging/prod) ---
DATABASE_URL=postgresql+asyncpg://ps08:ps08_password@localhost:5432/ps08
REDIS_URL=redis://localhost:6379/0

# --- Session / websocket ---
WEBSOCKET_TICKET_TTL_SECONDS=60

# --- Retention ---
EVENT_RETENTION_DAYS=30
ALERT_STREAM_RETENTION_DAYS=90

# --- JWT verification ---
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# --- Signing / HMAC keys (rotate without image rebuild) ---
WEBSOCKET_TICKET_SIGNING_KEY=
EVENT_PRODUCER_HMAC_KEY=
MODEL_ARTIFACT_SIGNING_KEY=

# --- Response-action providers ---
RESPONSE_PROVIDER_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
